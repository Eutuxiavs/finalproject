<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Yonzon | Claim Registry</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="{{ asset('css/yonzon.css') }}" rel="stylesheet">
</head>
<body>

{% set startPath = app.user ? path('item_new') : path('app_register') %}

{# ============ NAV ============ #}
<header class="nav">
    <div class="wrap nav__inner">
        <a href="{{ path('app_home') }}" class="brand">
            <span class="brand__mark"><img src="{{ asset('images/logo.png') }}" alt="Yonzon logo"></span>
            <span class="brand__text">YONZON</span>
        </a>
        <nav class="nav__links">
            <a href="#certificate">Certificate</a>
            <a href="#process">The Process</a>
            <a href="#lost-found">Lost &amp; Found</a>
            <a href="#system">The System</a>
        </nav>
        <div class="nav__cta">
            {% if app.user %}
                <a href="{{ path('app_after_login') }}" class="link">My account</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="link">Log in</a>
            {% endif %}
            <a href="{{ startPath }}" class="btn btn--primary btn--sm">Register an item</a>
        </div>
    </div>
</header>

{# ============ HERO ============ #}
<section class="hero">
    <div class="wrap hero__grid">
        <div>
            <span class="eyebrow">Ownership registry · Verified records</span>
            <h1>Proof that it <em>belongs to you.</em></h1>
            <p class="lead">
                Register what you own, and Yonzon keeps the record: a verifiable claim,
                a certificate, and a way for a stranger to reach you without ever
                seeing your name.
            </p>
            <div class="hero__actions">
                <a href="{{ startPath }}" class="btn btn--primary">Register your first item</a>
                <a href="#certificate" class="btn btn--ghost">Read a certificate</a>
            </div>
        </div>

        <div class="hero__art">
            <div class="seal">
                <div class="seal__ring"></div>
                <div class="seal__core"><img src="{{ asset('images/logo.png') }}" alt="Yonzon logo"></div>
            </div>
            <div class="hero__chip hero__chip--a"><i class="bi bi-shield-check"></i> Verified owner</div>
            <div class="hero__chip hero__chip--b"><i class="bi bi-qr-code"></i> QR issued instantly</div>
        </div>
    </div>
</section>

{# ============ CERTIFICATE (specimen) ============ #}
<section class="section" id="certificate">
    <div class="wrap">
        <div class="section__head section__head--center">
            <span class="eyebrow">Specimen</span>
            <h2>What a registered claim looks like</h2>
        </div>

        <article class="cert">
            <div class="cert__bar">
                <span class="brand brand--light">
                    <span class="brand__mark"><img src="{{ asset('images/logo.png') }}" alt="Yonzon logo"></span>
                    <span class="brand__text">YONZON</span>
                </span>
                <span class="cert__title">Certificate of Ownership</span>
            </div>

            <div class="cert__body">
                <p class="cert__small">
                    This certifies that the item described below has been recorded under a
                    verified Yonzon account, with supporting proof of purchase held in confidence.
                </p>
                <h3 class="cert__item">Sample Item Name</h3>

                <dl class="cert__meta">
                    <div><dt>Owner</dt><dd>Your Name</dd></div>
                    <div><dt>Claim ID</dt><dd>YZ-XXXX-000001</dd></div>
                    <div><dt>Serial no.</dt><dd>•••••000</dd></div>
                    <div><dt>Registered</dt><dd>{{ 'now'|date('d M Y') }}</dd></div>
                </dl>
            </div>

            <div class="cert__foot">
                <div class="qr"><i class="bi bi-qr-code"></i></div>
                <div class="cert__stamp">Verified</div>
            </div>
        </article>
    </div>
</section>

{# ============ PROCESS ============ #}
<section class="section section--sage" id="process">
    <div class="wrap">
        <div class="section__head">
            <span class="eyebrow">Filing procedure</span>
            <h2>Five entries make a record.</h2>
            <p class="muted">The order is fixed on purpose. Each entry becomes evidence for the one after it.</p>
        </div>

        <ol class="steps">
            {% for step in steps %}
                <li class="step">
                    <span class="step__num">{{ step[0] }}</span>
                    <h3>{{ step[1] }}</h3>
                    <p>{{ step[2] }}</p>
                </li>
            {% endfor %}
        </ol>
    </div>
</section>

{# ============ FILED ITEMS (real data) ============ #}
<section class="section">
    <div class="wrap">
        <div class="section__head">
            <span class="eyebrow">Registry</span>
            <h2>Filed with Yonzon.</h2>
            {% if stats.items > 0 %}
                <p class="muted">
                    {{ stats.items }} registered item{{ stats.items == 1 ? '' : 's' }}
                    · {{ stats.sale }} for sale · {{ stats.lost }} lost
                    · {{ stats.members }} member{{ stats.members == 1 ? '' : 's' }}.
                    Every item gets the same certificate and the same quiet protection.
                </p>
            {% else %}
                <p class="muted">Items registered by our members will appear here.</p>
            {% endif %}
        </div>

        {% if latest is empty %}
            <div class="empty-state">
                <i class="bi bi-box-seam"></i>
                <p>No items have been registered yet.</p>
                <a href="{{ startPath }}" class="btn btn--primary btn--sm">Be the first to register</a>
            </div>
        {% else %}
            <div class="grid grid--3">
                {% for item in latest %}
                    <article class="card">
                        <div class="card__photo">
                            {% if item.photo %}
                                <img src="{{ asset(item.photo) }}" alt="{{ item.name }}">
                            {% else %}
                                <i class="bi bi-box-seam"></i>
                            {% endif %}
                        </div>
                        <div class="card__top">
                            <span class="card__cat">{{ item.category }}</span>
                            <span class="badge badge--{{ item.status }}">
                                {{ item.status == 'for_sale' ? 'For sale' : (item.status == 'lost' ? 'Lost' : 'Owned') }}
                            </span>
                        </div>
                        <h3>{{ item.name }}</h3>
                        <div class="card__meta">
                            <span>{{ item.claimId }}</span>
                            <span>Registered {{ item.createdAt|date('d M Y') }}</span>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>

{# ============ LOST & FOUND ============ #}
<section class="section section--ink" id="lost-found">
    <div class="wrap split">
        <div>
            <span class="eyebrow eyebrow--light">If it's ever lost</span>
            <h2>A stranger can reach you without ever knowing who you are.</h2>
            <p class="lead lead--light">
                Every registered item carries a claim ID. Report it lost and it shows up in
                Lost &amp; Found on the marketplace, with only a status and a claim ID, never
                your name, phone number, or address.
            </p>
            <ul class="ticks">
                <li><i class="bi bi-check2-circle"></i> Personal details never shown</li>
                <li><i class="bi bi-check2-circle"></i> Serial numbers stay private</li>
                <li><i class="bi bi-check2-circle"></i> Status updates the moment it's reported lost</li>
            </ul>
        </div>

        <aside class="scan">
            <span class="scan__label">Lost &amp; Found</span>
            <p class="scan__title"><i class="bi bi-patch-check-fill"></i> {{ stats.lost }} item{{ stats.lost == 1 ? '' : 's' }} currently reported lost.</p>
            <dl>
                <div><dt>Registered items</dt><dd>{{ stats.items }}</dd></div>
                <div><dt>For sale</dt><dd>{{ stats.sale }}</dd></div>
            </dl>
            <a href="{{ path('marketplace', {filter: 'lost'}) }}" class="btn btn--accent btn--block">Browse Lost &amp; Found</a>
        </aside>
    </div>
</section>

{# ============ SYSTEM / ROOMS ============ #}
<section class="section" id="system">
    <div class="wrap">
        <div class="section__head">
            <span class="eyebrow">Floor directory</span>
            <h2>One record, five rooms to manage it in.</h2>
        </div>

        <div class="rooms">
            {% for room in rooms %}
                <a class="room" href="{{ path(room[4]) }}">
                    <span class="room__icon"><i class="bi {{ room[0] }}"></i></span>
                    <div class="room__text">
                        <h3>{{ room[1] }}</h3>
                        <p>{{ room[2] }}</p>
                    </div>
                    <span class="room__meta">{{ room[3] }}</span>
                    <i class="bi bi-arrow-right room__arrow"></i>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

{# ============ CTA ============ #}
<section class="cta">
    <div class="wrap cta__inner">
        <h2>Give what you own a record that outlasts the receipt.</h2>
        <p>One short form files your first claim. A lifetime to be glad you did.</p>
        <a href="{{ startPath }}" class="btn btn--accent">Register an item</a>
    </div>
</section>

{# ============ FOOTER ============ #}
<footer class="footer">
    <div class="wrap footer__grid">
        <div>
            <a href="{{ path('app_home') }}" class="brand brand--light">
                <span class="brand__mark"><img src="{{ asset('images/logo.png') }}" alt="Yonzon logo"></span>
                <span class="brand__text">YONZON</span>
            </a>
            <p class="footer__tag">A verified ownership registry for the things worth keeping track of.</p>
        </div>
        <div>
            <h4>Registry</h4>
            <a href="#certificate">Certificate</a>
            <a href="#process">The Process</a>
            <a href="#lost-found">Lost &amp; Found</a>
        </div>
        <div>
            <h4>Company</h4>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </div>
        <div>
            <h4>Filed by</h4>
            <p>Jayvee Yonzon<br><span class="muted-light">Framer &amp; Designer</span></p>
        </div>
    </div>
    <div class="wrap footer__bottom">
        © {{ 'now'|date('Y') }} Yonzon Claim Registry. All records reserved.
    </div>
</footer>

</body>
</html>