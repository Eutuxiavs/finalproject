{% extends 'auth/base_auth.html.twig' %}

{% block title %}Forgot password | Yonzon{% endblock %}

{% block content %}
    <h1>Forgot your password?</h1>
    <p class="auth__sub">Enter your account email and we will create a reset link.</p>

    {% if sent %}
        <div class="alert alert--success" role="status">
            If an account exists for that email, a reset link is ready below.
        </div>
        {% if link %}
            <div class="alert alert--info">
                <strong>Demo mode:</strong> this project has no mail server, so the link is shown here instead of being emailed.
                It expires in one hour.<br>
                <a href="{{ link }}">Open the reset link</a>
            </div>
        {% endif %}
    {% else %}
        <form method="post" class="auth-form">
            <input type="hidden" name="_token" value="{{ csrf_token('forgot') }}">
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" class="field__input" placeholder="you@example.com" autocomplete="email" required autofocus>
            </div>
            <button type="submit" class="btn-auth">Create reset link</button>
        </form>
    {% endif %}

    <p class="auth__switch"><a href="{{ path('app_login') }}">&larr; Back to log in</a></p>
{% endblock %}
