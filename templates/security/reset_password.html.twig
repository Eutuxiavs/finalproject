{% extends 'auth/base_auth.html.twig' %}

{% block title %}Reset password | Yonzon{% endblock %}

{% block content %}
    <h1>Choose a new password</h1>

    {% if not valid %}
        <div class="alert alert--error" role="alert">This reset link is invalid or has expired.</div>
        <p class="auth__switch"><a href="{{ path('app_forgot_password') }}">Request a new link</a></p>
    {% else %}
        <p class="auth__sub">Pick a password with at least 8 characters.</p>

        {% for error in errors %}
            <div class="alert alert--error" role="alert">{{ error }}</div>
        {% endfor %}

        <form method="post" class="auth-form">
            <input type="hidden" name="_token" value="{{ csrf_token('reset') }}">
            <div class="field">
                <label for="password">New password</label>
                <input type="password" id="password" name="password" class="field__input" autocomplete="new-password" minlength="8" required autofocus>
            </div>
            <div class="field">
                <label for="confirm">Confirm password</label>
                <input type="password" id="confirm" name="confirm" class="field__input" autocomplete="new-password" minlength="8" required>
            </div>
            <button type="submit" class="btn-auth">Update password</button>
        </form>
    {% endif %}
{% endblock %}
