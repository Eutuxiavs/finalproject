{% extends 'auth/base_auth.html.twig' %}

{% block title %}Log in | Yonzon{% endblock %}

{% block content %}
    <h1>Welcome back</h1>
    <p class="auth__sub">Log in to manage your registered items.</p>

    {% for message in app.flashes('success') %}
        <div class="alert alert--success">{{ message }}</div>
    {% endfor %}

    {% if error %}
        <div class="alert alert--error">Invalid email or password.</div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" class="auth-form">
        <div class="field">
            <label for="username">Email</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}"
                   class="field__input" placeholder="you@example.com" autocomplete="email" required autofocus>
        </div>

        <div class="field">
            <label for="password">Password</label>
            <input type="password" id="password" name="_password"
                   class="field__input" placeholder="Your password" autocomplete="current-password" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn-auth">Log in</button>
    </form>

    <p class="auth__switch">New to Yonzon? <a href="{{ path('app_register') }}">Create an account</a></p>
    <p class="auth__switch"><a href="{{ path('app_home') }}">&larr; Back to home</a></p>
{% endblock %}