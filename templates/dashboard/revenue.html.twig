{% extends 'base.html.twig' %}

{% block title %}Revenue | Yonzon{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <div class="col-12 col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <p class="text-muted mb-1">Total platform revenue</p>
                <h3 class="mb-0">${{ total|number_format(2) }}</h3>
                <small class="text-muted">5% fee on completed cash deals, plus simulated featured-listing fees.</small>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold">Latest entries</div>
    {% if rows is empty %}
        <p class="text-center text-muted py-5 mb-0">No revenue recorded yet.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Date</th><th>Source</th><th>Item</th><th>User</th><th class="text-end">Amount</th></tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.createdAt|date('d M Y H:i') }}</td>
                            <td>{{ row.source == 'featured_listing' ? 'Featured listing' : 'Transaction fee' }}</td>
                            <td>{{ row.item ? row.item.name : '—' }}</td>
                            <td>{{ row.user ? row.user.fullName : '—' }}</td>
                            <td class="text-end">${{ row.amount|number_format(2) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
