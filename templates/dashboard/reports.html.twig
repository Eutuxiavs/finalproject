{% extends 'base.html.twig' %}

{% block title %}Reports | Yonzon{% endblock %}

{% block body %}
<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold">User reports ({{ reports|length }})</div>

    {% if reports is empty %}
        <p class="text-center text-muted py-5 mb-0">No reports have been filed.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Listing</th>
                        <th>Reported user</th>
                        <th>Reporter</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for report in reports %}
                        <tr>
                            <td>{{ report.createdAt|date('d M Y') }}</td>
                            <td>{{ report.reportedItem ? report.reportedItem.name : (report.itemLabel ? report.itemLabel ~ ' (removed)' : '—') }}</td>
                            <td>{{ report.reportedUser ? report.reportedUser.fullName : '—' }}{% if report.reportedUser and report.reportedUser.suspended %} <span class="badge text-bg-danger">Suspended</span>{% endif %}</td>
                            <td>{{ report.reporter.fullName }}</td>
                            <td class="text-wrap" style="max-width: 280px">{{ report.reason }}</td>
                            <td><span class="badge text-bg-{{ report.status == 'open' ? 'warning' : (report.status == 'reviewed' ? 'success' : 'secondary') }}">{{ report.status|capitalize }}</span></td>
                            <td class="text-end">
                                {% if report.status == 'open' %}
                                    {% set t = csrf_token('admin_report_' ~ report.id) %}
                                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                        {% if report.reportedItem %}
                                            <form method="post" action="{{ path('admin_report_action', {id: report.id, action: 'remove_item'}) }}" data-confirm="Remove this listing permanently?">
                                                <input type="hidden" name="_token" value="{{ t }}">
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Remove listing</button>
                                            </form>
                                        {% endif %}
                                        {% if report.reportedUser and not report.reportedUser.suspended and not report.reportedUser.admin %}
                                            <form method="post" action="{{ path('admin_report_action', {id: report.id, action: 'suspend_user'}) }}" data-confirm="Suspend this user?">
                                                <input type="hidden" name="_token" value="{{ t }}">
                                                <button class="btn btn-sm btn-outline-danger" type="submit">Suspend user</button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="{{ path('admin_report_action', {id: report.id, action: 'dismiss'}) }}">
                                            <input type="hidden" name="_token" value="{{ t }}">
                                            <button class="btn btn-sm btn-outline-secondary" type="submit">Dismiss</button>
                                        </form>
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
