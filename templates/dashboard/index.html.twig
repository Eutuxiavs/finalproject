{% extends 'base.html.twig' %}

{% block title %}Dashboard | Yonzon{% endblock %}

{% block body %}
{% set cards = [
    ['Users', stats.users, 'bi-people', 'text-primary'],
    ['Registered Items', stats.items, 'bi-box-seam', 'text-success'],
    ['For Sale', stats.sale, 'bi-shop', 'text-warning'],
    ['Reported Lost', stats.lost, 'bi-exclamation-diamond', 'text-danger'],
    ['Pending Offers', stats.pending, 'bi-hourglass-split', 'text-secondary'],
    ['Completed Deals', stats.deals, 'bi-patch-check', 'text-success'],
    ['Open Reports', stats.reports, 'bi-flag', 'text-danger'],
    ['Open Disputes', stats.disputes, 'bi-exclamation-octagon', 'text-danger'],
] %}
{% if stats.revenue is not null %}
    {% set cards = cards|merge([['Platform Revenue', '$' ~ stats.revenue|number_format(2), 'bi-cash-coin', 'text-primary']]) %}
{% endif %}

<div class="row g-4 mb-4">
    {% for card in cards %}
        <div class="col-6 col-xl-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1">{{ card[0] }}</p>
                        <h3 class="mb-0">{{ card[1] }}</h3>
                    </div>
                    <i class="bi {{ card[2] }} fs-1 {{ card[3] }}"></i>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold">Recent Claims</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Claim ID</th>
                    <th>Item</th>
                    <th>Category</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Filed</th>
                </tr>
            </thead>
            <tbody>
                {% for item in recent %}
                    <tr>
                        <td>{{ item.claimId }}</td>
                        <td>{{ item.name }}</td>
                        <td>{{ item.category }}</td>
                        <td>{{ item.owner.fullName }}</td>
                        <td>
                            <span class="badge text-bg-{{ item.status == 'for_sale' ? 'warning' : (item.status == 'lost' ? 'danger' : (item.status == 'reserved' ? 'info' : 'success')) }}">{{ item.status|status_label }}</span>
                        </td>
                        <td>{{ item.createdAt|date('d M Y') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">No claims have been filed yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}