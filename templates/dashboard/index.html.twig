{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard | Yonzon{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Users</p>
                    <h3 class="mb-0">{{ stats.users }}</h3>
                </div>
                <i class="bi bi-people fs-1 text-primary"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Registered Items</p>
                    <h3 class="mb-0">{{ stats.items }}</h3>
                </div>
                <i class="bi bi-box-seam fs-1 text-success"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">For Sale</p>
                    <h3 class="mb-0">{{ stats.sale }}</h3>
                </div>
                <i class="bi bi-shop fs-1 text-warning"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Reported Lost</p>
                    <h3 class="mb-0">{{ stats.lost }}</h3>
                </div>
                <i class="bi bi-exclamation-diamond fs-1 text-danger"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Pending Offers</p>
                    <h3 class="mb-0">{{ stats.pending }}</h3>
                </div>
                <i class="bi bi-envelope-paper fs-1 text-secondary"></i>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold">Recent Claims</div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Claim ID</th>
                    <th>Item</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                {% for item in recent %}
                    <tr>
                        <td>{{ item.claimId }}</td>
                        <td>{{ item.name }}</td>
                        <td>{{ item.owner.fullName }}</td>
                        <td>
                            {% if item.status == 'for_sale' %}
                                <span class="badge text-bg-warning">For sale</span>
                            {% elseif item.status == 'lost' %}
                                <span class="badge text-bg-danger">Lost</span>
                            {% else %}
                                <span class="badge text-bg-success">Owned</span>
                            {% endif %}
                        </td>
                        <td>{{ item.createdAt|date('d M Y') }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">No claims have been filed yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}