{% extends 'app/base_app.html.twig' %}

{% block title %}{{ item.name }} | Yonzon{% endblock %}

{% block content %}
    <p class="eyebrow">Claim {{ item.claimId }}</p>

    <div class="page-head">
        <h1>{{ item.name }}</h1>
        <a class="btn btn--ghost" href="{{ path('user_registry') }}">&larr; Back to registry</a>
    </div>

    {% set token = csrf_token('item_' ~ item.id) %}
    {% set updateUrl = path('item_update', {id: item.id}) %}

    <div class="split">
        <section class="panel">
            <div class="detail__img">
                {% if item.photo %}
                    <img src="{{ asset(item.photo) }}" alt="{{ item.name }}">
                {% else %}
                    <i class="bi bi-image"></i>
                {% endif %}
            </div>

            {% if item.status != 'reserved' %}
                <form method="post" action="{{ updateUrl }}" enctype="multipart/form-data" class="action photoform">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="action" value="photo">
                    <label for="photo">{{ item.photo ? 'Replace photo' : 'Add a photo' }}</label>
                    <input class="input" id="photo" type="file" name="photo" accept="image/jpeg,image/png,image/webp" required>
                    <button class="btn btn--ghost btn--sm" type="submit">Upload photo</button>
                </form>
            {% endif %}

            <dl class="details">
                <div><dt>Category</dt><dd>{{ item.category }}</dd></div>
                <div><dt>Claim ID</dt><dd>{{ item.claimId }}</dd></div>
                <div><dt>Serial number <small>(only you can see this)</small></dt><dd>{{ item.serialNumber ?: '—' }}</dd></div>
                <div><dt>Condition</dt><dd>{{ item.itemCondition ?: '—' }}</dd></div>
                <div><dt>City</dt><dd>{{ item.city ?: '—' }}</dd></div>
                <div><dt>Registered</dt><dd>{{ item.createdAt|date('d M Y') }}</dd></div>
                <div><dt>Notes</dt><dd>{{ item.notes ?: '—' }}</dd></div>
            </dl>
        </section>

        <aside class="stack">
            <section class="panel">
                <h2>Status</h2>
                <p>
                    <span class="badge badge--{{ item.status }}">{{ item.status|status_label }}</span>
                    {% if item.featuredNow %}<span class="badge badge--featured">Featured until {{ item.featuredUntil|date('d M') }}</span>{% endif %}
                    {% if item.status in ['for_sale', 'reserved'] and item.price %}
                        <strong class="inline-price">${{ item.price|number_format(2) }}</strong>
                    {% endif %}
                </p>

                {% if item.status == 'reserved' %}
                    <p class="muted">This item is part of an accepted deal. Finish or cancel the deal on the Offers page before changing it.</p>
                    <a class="btn btn--accent btn--sm btn--block" href="{{ path('offers') }}">Go to offers</a>
                {% elseif item.status == 'owned' %}
                    {% if item.photo %}
                        <form method="post" action="{{ updateUrl }}" class="action">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="action" value="sell">
                            <label for="sell-price">List for sale ($)</label>
                            <input class="input" id="sell-price" type="number" name="price" min="1" step="0.01" placeholder="Asking price" required>
                            <button class="btn btn--primary btn--sm btn--block" type="submit">List on marketplace</button>
                        </form>
                    {% else %}
                        <p class="muted">Add a photo of the item to list it for sale.</p>
                    {% endif %}
                    <form method="post" action="{{ updateUrl }}" class="action">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="action" value="lost">
                        <button class="btn btn--ghost btn--sm btn--block" type="submit">Report lost</button>
                    </form>
                {% elseif item.status == 'for_sale' %}
                    {% if not item.featuredNow %}
                        <form method="post" action="{{ updateUrl }}" class="action" data-confirm="Feature this listing for {{ featureDays }} days? This is a simulated ${{ featureFee }} charge.">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="action" value="feature">
                            <button class="btn btn--accent btn--sm btn--block" type="submit"><i class="bi bi-star"></i> Feature listing (${{ featureFee }}, {{ featureDays }} days)</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ updateUrl }}" class="action">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="action" value="unlist">
                        <button class="btn btn--ghost btn--sm btn--block" type="submit">Take off marketplace</button>
                    </form>
                    <form method="post" action="{{ updateUrl }}" class="action">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="action" value="lost">
                        <button class="btn btn--ghost btn--sm btn--block" type="submit">Report lost</button>
                    </form>
                {% else %}
                    <form method="post" action="{{ updateUrl }}" class="action">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="action" value="found">
                        <button class="btn btn--primary btn--sm btn--block" type="submit">I found it</button>
                    </form>
                {% endif %}

                {% if item.status != 'reserved' %}
                    <form method="post" action="{{ updateUrl }}" class="action" data-confirm="Delete this claim for good?">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="action" value="delete">
                        <button class="link-danger" type="submit">Delete this claim</button>
                    </form>
                {% endif %}
            </section>

            {% if item.status in ['for_sale', 'reserved'] %}
                <section class="panel">
                    <h2>Offers on this item</h2>
                    {% if offers is empty %}
                        <p class="muted">No offers yet.</p>
                    {% else %}
                        <ul class="mini">
                            {% for offer in offers %}
                                <li>
                                    <span>{{ offer.buyer.fullName }}</span>
                                    <strong>{{ offer.type == 'trade' ? 'Trade' : '$' ~ offer.amount|number_format(2) }}</strong>
                                    <span class="badge badge--{{ offer.status }}">{{ offer.status|status_label }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                        <a class="btn btn--ghost btn--sm btn--block" href="{{ path('offers') }}">Manage offers</a>
                    {% endif %}
                </section>
            {% endif %}

            <section class="panel">
                <h2>Ownership history</h2>
                <ul class="mini">
                    <li><span>Registered by you</span><span class="muted">{{ item.createdAt|date('d M Y') }}</span></li>
                    {% for h in history|reverse %}
                        <li>
                            <span>{{ h.previousOwner.fullName }} &rarr; {{ h.newOwner.fullName }}</span>
                            <span class="muted">{{ h.transferredAt|date('d M Y') }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </aside>
    </div>
{% endblock %}
