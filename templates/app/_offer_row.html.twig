{% macro act(offer, action, label, cls, ask) %}
    <form method="post" action="{{ path('offer_action', {id: offer.id, action: action}) }}" {% if ask %}data-confirm="{{ ask }}"{% endif %}>
        <input type="hidden" name="_token" value="{{ csrf_token('offer_' ~ offer.id) }}">
        <button class="btn {{ cls }} btn--sm" type="submit">{{ label }}</button>
    </form>
{% endmacro %}

{% import _self as m %}

{% set isSeller = role == 'seller' %}
{% set other = isSeller ? offer.buyer : offer.seller %}
{% set myDone = isSeller ? offer.sellerConfirmed : offer.buyerConfirmed %}
{% set theirDone = isSeller ? offer.buyerConfirmed : offer.sellerConfirmed %}

<article class="offer">
    <div class="offer__main">
        <h3><a href="{{ path('listing_show', {id: offer.item.id}) }}">{{ offer.item.name }}</a> <small>{{ offer.item.claimId }}</small></h3>
        <p>
            {{ isSeller ? 'From' : 'To' }} <a href="{{ path('profile_public', {id: other.id}) }}">{{ other.fullName }}</a>
            · {{ offer.createdAt|date('d M Y') }}
        </p>
        <p class="offer__price">
            {% if offer.type == 'cash' %}
                <strong>${{ offer.amount|number_format(2) }}</strong> cash
            {% elseif offer.type == 'trade' %}
                Trade: <strong>{{ offer.tradeItem ? offer.tradeItem.name : 'item no longer available' }}</strong>
            {% else %}
                <strong>${{ offer.amount|number_format(2) }}</strong> + trade <strong>{{ offer.tradeItem ? offer.tradeItem.name : 'item no longer available' }}</strong>
            {% endif %}
        </p>
        {% if offer.message %}<p class="offer__msg">&ldquo;{{ offer.message }}&rdquo;</p>{% endif %}

        {% if offer.status == 'pending' and offer.expiresAt %}
            <p class="offer__hint">Expires {{ offer.expiresAt|date('d M Y, H:i') }}</p>
        {% endif %}

        {% if offer.status == 'accepted' %}
            <p class="offer__hint">
                Handover: you {{ myDone ? 'confirmed' : 'have not confirmed yet' }},
                the other side {{ theirDone ? 'confirmed' : 'has not confirmed yet' }}.
            </p>
            {% if offer.meetupNote %}<p class="offer__meetup"><i class="bi bi-geo-alt"></i> {{ offer.meetupNote }}</p>{% endif %}
            <form class="offer__note" method="post" action="{{ path('offer_meetup', {id: offer.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('offer_' ~ offer.id) }}">
                <input class="input" type="text" name="note" maxlength="300" value="{{ offer.meetupNote }}" placeholder="Meetup place and time, e.g. SM City lobby, Sat 3pm" aria-label="Meetup note">
                <button class="btn btn--ghost btn--sm" type="submit">Save note</button>
            </form>
        {% endif %}

        {% if offer.status == 'completed' %}
            {% if reviewed[offer.id] is defined %}
                <p class="offer__hint">You reviewed this deal.</p>
            {% else %}
                <form class="offer__review" method="post" action="{{ path('offer_review', {id: offer.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ offer.id) }}">
                    <label for="rating-{{ offer.id }}">Rate {{ other.fullName }}</label>
                    <select class="input" id="rating-{{ offer.id }}" name="rating" required>
                        <option value="">Stars</option>
                        {% for n in 5..1 %}<option value="{{ n }}">{{ n }} star{{ n == 1 ? '' : 's' }}</option>{% endfor %}
                    </select>
                    <input class="input" type="text" name="comment" maxlength="500" placeholder="Comment (optional)" aria-label="Review comment">
                    <button class="btn btn--primary btn--sm" type="submit">Submit review</button>
                </form>
            {% endif %}
        {% endif %}
    </div>

    <div class="offer__side">
        <span class="badge badge--{{ offer.status }}">{{ offer.status|status_label }}</span>

        <div class="offer__actions">
            {% if offer.status == 'pending' and isSeller %}
                {{ m.act(offer, 'accept', 'Accept', 'btn--primary', '') }}
                {{ m.act(offer, 'decline', 'Decline', 'btn--ghost', '') }}
            {% elseif offer.status == 'pending' %}
                {{ m.act(offer, 'withdraw', 'Withdraw offer', 'btn--ghost', '') }}
            {% elseif offer.status == 'accepted' %}
                {% if not myDone %}
                    {{ m.act(offer, 'confirm', 'Confirm handover complete', 'btn--accent', 'Only confirm after the exchange actually happened. Continue?') }}
                {% endif %}
                {{ m.act(offer, 'cancel', 'Cancel deal', 'btn--ghost', 'Cancel this deal?') }}
            {% elseif offer.status == 'completed' %}
                {{ m.act(offer, 'dispute', 'Report a problem', 'btn--ghost', 'Flag this deal as disputed so an admin can see it?') }}
            {% endif %}
            {% if offer.status in ['pending', 'accepted'] %}
                <a class="btn btn--ghost btn--sm" href="{{ path('message_start', {id: offer.item.id}) }}">Message</a>
            {% endif %}
        </div>
    </div>
</article>
