{% extends 'app/base_app.html.twig' %}

{% block title %}Register an item | Yonzon{% endblock %}

{% block content %}
    <p class="eyebrow">Filing procedure</p>

    <div class="page-head">
        <h1>Register an item.</h1>
        <a class="btn btn--ghost" href="{{ path('user_registry') }}">&larr; Back to registry</a>
    </div>

    {% if errors %}
        <div class="flash flash--error">
            <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <form method="post" enctype="multipart/form-data" class="panel form">
        <input type="hidden" name="_token" value="{{ csrf_token('item_new') }}">

        <div class="form__row">
            <div class="field">
                <label for="name">Item name</label>
                <input class="input" id="name" name="name" value="{{ data.name }}" placeholder="e.g. Leica Camera M11" maxlength="160" required>
            </div>
            <div class="field">
                <label for="category">Category</label>
                <select class="input" id="category" name="category" required>
                    <option value="">Choose one</option>
                    {% for c in categories %}
                        <option value="{{ c }}" {{ data.category == c ? 'selected' }}>{{ c }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="form__row">
            <div class="field">
                <label for="serial">Serial number <em>(optional)</em></label>
                <input class="input" id="serial" name="serial" value="{{ data.serial }}" placeholder="Kept private, never shown publicly" maxlength="120">
            </div>
            <div class="field">
                <label for="condition">Condition <em>(optional)</em></label>
                <select class="input" id="condition" name="condition">
                    <option value="">Not specified</option>
                    {% for c in conditions %}
                        <option value="{{ c }}" {{ data.condition == c ? 'selected' }}>{{ c }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="field">
            <label for="city">City <em>(optional, helps local buyers find it)</em></label>
            <input class="input" id="city" name="city" value="{{ data.city }}" placeholder="e.g. Cebu City" maxlength="120">
        </div>

        <div class="field">
            <label for="notes">Notes <em>(optional)</em></label>
            <textarea class="input" id="notes" name="notes" rows="4" maxlength="1000" placeholder="Purchase details, condition, anything worth recording.">{{ data.notes }}</textarea>
        </div>

        <div class="field">
            <label for="photo">Photo <em>(optional, JPG, PNG or WEBP up to 5 MB)</em></label>
            <label class="upload" for="photo">
                <i class="bi bi-image"></i>
                <span id="photoName">Click to upload a photo</span>
            </label>
            <input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" hidden>
        </div>

        <div class="field">
            <label>What should happen to it?</label>
            <div class="choices">
                <label class="choice">
                    <input type="radio" name="listing" value="inventory" {{ data.listing == 'inventory' ? 'checked' }}>
                    <span><strong>Keep in inventory</strong><small>Only you can see it. Your proof of ownership.</small></span>
                </label>
                <label class="choice">
                    <input type="radio" name="listing" value="sale" {{ data.listing == 'sale' ? 'checked' }}>
                    <span><strong>List for sale</strong><small>Shows on the marketplace so people can make offers.</small></span>
                </label>
                <label class="choice">
                    <input type="radio" name="listing" value="lost" {{ data.listing == 'lost' ? 'checked' }}>
                    <span><strong>Report lost</strong><small>Posts to Lost &amp; Found with only its claim ID.</small></span>
                </label>
            </div>
        </div>

        <div class="field" id="priceField" hidden>
            <label for="price">Asking price ($)</label>
            <input class="input" id="price" name="price" type="number" min="1" step="0.01" value="{{ data.price }}" placeholder="e.g. 450.00">
        </div>

        <button type="submit" class="btn btn--primary btn--block">File this claim</button>
    </form>

    <script>
        var photo = document.getElementById('photo');
        photo.addEventListener('change', function () {
            document.getElementById('photoName').textContent = this.files.length ? this.files[0].name : 'Click to upload a photo';
        });

        var priceField = document.getElementById('priceField');
        var priceInput = document.getElementById('price');
        function syncPrice() {
            var sale = document.querySelector('input[name="listing"]:checked').value === 'sale';
            priceField.hidden = !sale;
            priceInput.required = sale;
        }
        document.querySelectorAll('input[name="listing"]').forEach(function (r) {
            r.addEventListener('change', syncPrice);
        });
        syncPrice();
    </script>
{% endblock %}