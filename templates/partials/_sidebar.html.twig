{% set route = app.request.attributes.get('_route') %}
{% set counts = staff_counts() %}

<aside class="sidebar" id="sidebar">
    <a href="{{ path('app_home') }}" class="sidebar-brand">
        <img src="{{ asset('images/logo.png') }}" alt="Yonzon logo" class="sidebar-logo">
        <span>YONZON</span>
    </a>

    <ul class="nav flex-column sidebar-nav">
        <li class="nav-item">
            <a class="nav-link {{ route == 'app_dashboard' ? 'active' : '' }}" href="{{ path('app_dashboard') }}">
                <i class="bi bi-house-door"></i>
                <span>Dashboard</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ route == 'app_users' ? 'active' : '' }}" href="{{ path('app_users') }}">
                <i class="bi bi-people"></i>
                <span>Users</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ route == 'app_reports' ? 'active' : '' }}" href="{{ path('app_reports') }}">
                <i class="bi bi-flag"></i>
                <span>Reports{% if counts.reports %} <b class="badge text-bg-danger">{{ counts.reports }}</b>{% endif %}</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ route == 'app_listings' ? 'active' : '' }}" href="{{ path('app_listings') }}">
                <i class="bi bi-card-list"></i>
                <span>Listings</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link {{ route == 'app_disputes' ? 'active' : '' }}" href="{{ path('app_disputes') }}">
                <i class="bi bi-exclamation-octagon"></i>
                <span>Disputes{% if counts.disputes %} <b class="badge text-bg-danger">{{ counts.disputes }}</b>{% endif %}</span>
            </a>
        </li>
        {% if is_granted('ROLE_ADMIN') %}
            <li class="nav-item">
                <a class="nav-link {{ route == 'app_revenue' ? 'active' : '' }}" href="{{ path('app_revenue') }}">
                    <i class="bi bi-cash-coin"></i>
                    <span>Revenue</span>
                </a>
            </li>
        {% endif %}
        <li class="nav-item">
            <a class="nav-link" href="{{ path('marketplace') }}">
                <i class="bi bi-shop"></i>
                <span>Marketplace</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path('app_home') }}">
                <i class="bi bi-box-arrow-up-right"></i>
                <span>Landing page</span>
            </a>
        </li>
    </ul>
</aside>